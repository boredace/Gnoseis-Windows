<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Gnoseis.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Gnoseis">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" PointerPressed="RootGrid_PointerPressed">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Left" Modifiers="Menu" Invoked="BackAccelerator_Invoked" />
            <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="SearchAccelerator_Invoked" />
            <KeyboardAccelerator Key="Number1" Modifiers="Control" Invoked="SectionAccelerator_Invoked" />
            <KeyboardAccelerator Key="Number2" Modifiers="Control" Invoked="SectionAccelerator_Invoked" />
            <KeyboardAccelerator Key="Number3" Modifiers="Control" Invoked="SectionAccelerator_Invoked" />
            <KeyboardAccelerator Key="Number4" Modifiers="Control" Invoked="SectionAccelerator_Invoked" />
            <KeyboardAccelerator Key="Number5" Modifiers="Control" Invoked="SectionAccelerator_Invoked" />
            <KeyboardAccelerator Key="Number6" Modifiers="Control" Invoked="SectionAccelerator_Invoked" />
        </Grid.KeyboardAccelerators>

        <!-- Windows 11 title bar: back, pane toggle, app name and search in the middle. -->
        <TitleBar
            x:Name="AppTitleBar"
            Title="Gnoseis"
            BackRequested="AppTitleBar_BackRequested"
            IsBackButtonEnabled="False"
            IsBackButtonVisible="True"
            IsPaneToggleButtonVisible="True"
            PaneToggleRequested="AppTitleBar_PaneToggleRequested">
            <TitleBar.IconSource>
                <FontIconSource Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Glyph="&#xE8F1;" />
            </TitleBar.IconSource>
            <TitleBar.Content>
            <AutoSuggestBox
                x:Name="SearchBox"
                MinWidth="280"
                MaxWidth="560"
                VerticalAlignment="Center"
                AutomationProperties.Name="Search all records"
                ItemTemplate="{StaticResource RecordRowTemplate}"
                PlaceholderText="Search notes, contacts, organizations… (Ctrl+F)"
                QueryIcon="Find"
                QuerySubmitted="SearchBox_QuerySubmitted"
                TextChanged="SearchBox_TextChanged" />
            </TitleBar.Content>
        </TitleBar>

        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            CompactModeThresholdWidth="700"
            ExpandedModeThresholdWidth="1100"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="True"
            IsTitleBarAutoPaddingEnabled="False"
            ItemInvoked="NavView_ItemInvoked"
            OpenPaneLength="240"
            PaneClosed="NavView_PaneChanged"
            PaneDisplayMode="Auto"
            PaneOpened="NavView_PaneChanged">

            <NavigationView.MenuItems>
                <NavigationViewItem Content="Home" Tag="Home" ToolTipService.ToolTip="Home (Ctrl+1)">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemSeparator />
                <NavigationViewItem Content="Notes" Tag="Note" ToolTipService.ToolTip="Notes (Ctrl+2)">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE70B;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Contacts" Tag="Contact" ToolTipService.ToolTip="Contacts (Ctrl+3)">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE77B;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Organizations" Tag="Organization" ToolTipService.ToolTip="Organizations (Ctrl+4)">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE821;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Categories" Tag="Category" ToolTipService.ToolTip="Categories (Ctrl+5)">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8EC;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Items" Tag="Item" ToolTipService.ToolTip="Items (Ctrl+6)">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7B8;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Frame x:Name="ContentFrame" Navigated="ContentFrame_Navigated" />
        </NavigationView>
    </Grid>
</Window>
