<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Gnoseis.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Gnoseis.App.Views"
    Title="Gnoseis">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" PointerPressed="RootGrid_PointerPressed">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Left" Modifiers="Menu" Invoked="BackAccelerator_Invoked" />
            <KeyboardAccelerator Key="Right" Modifiers="Menu" Invoked="ForwardAccelerator_Invoked" />
            <KeyboardAccelerator Key="E" Modifiers="Control" Invoked="SearchAccelerator_Invoked" />
            <KeyboardAccelerator Key="F3" Invoked="SearchAccelerator_Invoked" />
            <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="FindAccelerator_Invoked" />
            <KeyboardAccelerator Key="F6" Invoked="PaneAccelerator_Invoked" />
            <KeyboardAccelerator Key="F6" Modifiers="Shift" Invoked="PaneAccelerator_Invoked" />
            <KeyboardAccelerator Key="Number1" Modifiers="Control" Invoked="SectionAccelerator_Invoked" />
            <KeyboardAccelerator Key="Number2" Modifiers="Control" Invoked="SectionAccelerator_Invoked" />
            <KeyboardAccelerator Key="Number3" Modifiers="Control" Invoked="SectionAccelerator_Invoked" />
            <KeyboardAccelerator Key="Number4" Modifiers="Control" Invoked="SectionAccelerator_Invoked" />
            <KeyboardAccelerator Key="Number5" Modifiers="Control" Invoked="SectionAccelerator_Invoked" />
            <KeyboardAccelerator Key="Number6" Modifiers="Control" Invoked="SectionAccelerator_Invoked" />
        </Grid.KeyboardAccelerators>

        <!-- Windows 11 title bar: back, pane toggle, app name, search in the middle and the database in use on the right. -->
        <TitleBar
            x:Name="AppTitleBar"
            Title="Gnoseis"
            BackRequested="AppTitleBar_BackRequested"
            IsBackButtonEnabled="False"
            IsBackButtonVisible="True"
            IsPaneToggleButtonVisible="True"
            PaneToggleRequested="AppTitleBar_PaneToggleRequested">
            <TitleBar.Resources>
                <!-- The database link sits against the window buttons; the window is still dragged by the space beside the search box. -->
                <x:Double x:Key="TitleBarMinDragRegionWidth">4</x:Double>
            </TitleBar.Resources>
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/TitleBarIcon.png" />
            </TitleBar.IconSource>
            <TitleBar.Content>
            <AutoSuggestBox
                x:Name="SearchBox"
                MinWidth="280"
                MaxWidth="560"
                VerticalAlignment="Center"
                AutomationProperties.Name="Search all records"
                ItemTemplate="{StaticResource SearchSuggestionTemplate}"
                PlaceholderText="Search notes, contacts, organizations… (Ctrl+E)"
                QueryIcon="Find"
                QuerySubmitted="SearchBox_QuerySubmitted"
                TextChanged="SearchBox_TextChanged" />
            </TitleBar.Content>
            <TitleBar.RightHeader>
                <!-- The database in use; opens the list of databases (Gnoseis restarts to open another). -->
                <HyperlinkButton
                    x:Name="DatabaseLink"
                    Padding="6,2"
                    VerticalAlignment="Center"
                    Click="DatabaseLink_Click"
                    ToolTipService.ToolTip="Choose another database"
                    Visibility="Collapsed">
                    <TextBlock x:Name="DatabaseLinkText" TextDecorations="Underline" TextTrimming="CharacterEllipsis" MaxWidth="280" />
                    <FlyoutBase.AttachedFlyout>
                        <Flyout x:Name="DatabaseFlyout" Placement="BottomEdgeAlignedRight">
                            <Flyout.FlyoutPresenterStyle>
                                <!-- Wider than a flyout's default maximum, for the folder paths. -->
                                <Style TargetType="FlyoutPresenter">
                                    <Setter Property="MaxWidth" Value="560" />
                                </Style>
                            </Flyout.FlyoutPresenterStyle>
                            <StackPanel Width="460" Spacing="12">
                                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Choose a database" />
                                <views:DatabaseChooser x:Name="DatabaseChooser" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="Gnoseis restarts to open another database."
                                    TextWrapping="Wrap" />
                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                                    <Button Click="DatabaseAddFolder_Click" Content="Add folder…" />
                                    <Button
                                        x:Name="DatabaseOpenButton"
                                        MinWidth="96"
                                        Click="DatabaseOpen_Click"
                                        Content="Open"
                                        Style="{StaticResource AccentButtonStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </Flyout>
                    </FlyoutBase.AttachedFlyout>
                </HyperlinkButton>
            </TitleBar.RightHeader>
        </TitleBar>

        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            CompactModeThresholdWidth="700"
            ExpandedModeThresholdWidth="1500"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="True"
            IsTitleBarAutoPaddingEnabled="False"
            ItemInvoked="NavView_ItemInvoked"
            OpenPaneLength="240"
            PaneClosed="NavView_PaneChanged"
            PaneDisplayMode="Auto"
            PaneOpened="NavView_PaneChanged">

            <NavigationView.MenuItems>
                <NavigationViewItem Content="Home" Tag="Home" ToolTipService.ToolTip="Home (Ctrl+1)">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemSeparator />
                <NavigationViewItem Content="Notes" Tag="Note" ToolTipService.ToolTip="Notes (Ctrl+2)">
                    <NavigationViewItem.Icon>
                        <FontIcon Foreground="{ThemeResource NoteOutlineBrush}" Glyph="&#xE70B;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Contacts" Tag="Contact" ToolTipService.ToolTip="Contacts (Ctrl+3)">
                    <NavigationViewItem.Icon>
                        <FontIcon Foreground="{ThemeResource ContactOutlineBrush}" Glyph="&#xE77B;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Organizations" Tag="Organization" ToolTipService.ToolTip="Organizations (Ctrl+4)">
                    <NavigationViewItem.Icon>
                        <FontIcon Foreground="{ThemeResource OrganizationOutlineBrush}" Glyph="&#xE821;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Categories" Tag="Category" ToolTipService.ToolTip="Categories (Ctrl+5)">
                    <NavigationViewItem.Icon>
                        <FontIcon Foreground="{ThemeResource CategoryOutlineBrush}" Glyph="&#xE8EC;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Items" Tag="Item" ToolTipService.ToolTip="Items (Ctrl+6)">
                    <NavigationViewItem.Icon>
                        <FontIcon Foreground="{ThemeResource ItemOutlineBrush}" Glyph="&#xE7B8;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Frame x:Name="ContentFrame" Navigated="ContentFrame_Navigated" />
        </NavigationView>
    </Grid>
</Window>
