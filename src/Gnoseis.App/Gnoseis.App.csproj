<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>Gnoseis.App</RootNamespace>
    <AssemblyName>Gnoseis</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;x86;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-x86;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <!-- Unpackaged, self-contained desktop app: a plain Gnoseis.exe that needs no installer or runtime. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>14</LangVersion>
    <VersionPrefix>0.2.0</VersionPrefix>
    <Product>Gnoseis</Product>
    <Company>Gnoseis.org</Company>
    <Copyright>Copyright (C) 2024 Gnoseis.org</Copyright>
    <ApplicationIcon>Assets\Gnoseis.ico</ApplicationIcon>
    <!-- Program.cs is the entry point, so DLL loading is restricted before anything else runs. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <!-- A release build shows the plain version; the SDK would otherwise append +<full commit hash>. -->
  <PropertyGroup Condition="'$(Configuration)' != 'Debug'">
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <!--
    A debug build says where it was built from, so it can't be mistaken for a release:
    0.1.0-debug.12+a1b2c3d is 12 commits after the last release tag, at commit a1b2c3d (.dirty if there
    were uncommitted changes). Without git or without a tag it is plain 0.1.0-debug.
    Git can only run in a target, after the SDK has worked out Version from VersionPrefix and
    VersionSuffix, so Version is worked out again here. The project itself never sets Version.
  -->
  <Target Name="StampDebugVersion" BeforeTargets="GetAssemblyVersion" Condition="'$(Configuration)' == 'Debug'">
    <Exec
      Command="git describe --tags --match &quot;v*&quot; --long --dirty"
      WorkingDirectory="$(MSBuildProjectDirectory)"
      ConsoleToMSBuild="true"
      IgnoreExitCode="true"
      ContinueOnError="true"
      StandardOutputImportance="low"
      StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitDescribe" />
      <Output TaskParameter="ExitCode" PropertyName="_GitDescribeExitCode" />
    </Exec>
    <PropertyGroup>
      <_DescribePattern>^.*-(\d+)-g([0-9a-f]+)(-dirty)?$</_DescribePattern>
      <_DebugStamp>debug</_DebugStamp>
      <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    </PropertyGroup>
    <PropertyGroup Condition="'$(_GitDescribeExitCode)' == '0'">
      <_DebugStamp>debug.$([System.Text.RegularExpressions.Regex]::Replace($(_GitDescribe), $(_DescribePattern), '$1'))</_DebugStamp>
      <SourceRevisionId>$([System.Text.RegularExpressions.Regex]::Replace($(_GitDescribe), $(_DescribePattern), '$2$3').Replace('-dirty', '.dirty'))</SourceRevisionId>
      <IncludeSourceRevisionInInformationalVersion>true</IncludeSourceRevisionInInformationalVersion>
    </PropertyGroup>
    <PropertyGroup>
      <VersionSuffix Condition="'$(VersionSuffix)' != ''">$(VersionSuffix)-$(_DebugStamp)</VersionSuffix>
      <VersionSuffix Condition="'$(VersionSuffix)' == ''">$(_DebugStamp)</VersionSuffix>
      <Version>$(VersionPrefix)-$(VersionSuffix)</Version>
    </PropertyGroup>
  </Target>

  <!-- A self-contained WinUI app needs a Windows architecture; default to x64 for "Any CPU" builds. -->
  <PropertyGroup>
    <RuntimeIdentifier Condition="'$(Platform)' == 'x86'">win-x86</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Gnoseis.Core\Gnoseis.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
    <Content Include="Assets\Gnoseis.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\TitleBarIcon.scale-*.png" CopyToOutputDirectory="PreserveNewest" />
    <!-- The icon sources (Assets\source) are for regenerating the images, not for the app. -->
    <Content Remove="Assets\source\**" />
    <None Remove="Assets\source\**" />
  </ItemGroup>

</Project>
