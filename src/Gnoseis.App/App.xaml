<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Gnoseis.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:res="using:Gnoseis.App.Resources">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <res:RecordTypeColorResources />
                <res:RecordTemplates />
            </ResourceDictionary.MergedDictionaries>

            <!-- Page layout -->
            <Thickness x:Key="PageMargin">36,24,36,0</Thickness>
            <Thickness x:Key="PageContentMargin">36,0,36,24</Thickness>
            <x:Double x:Key="FormMaxWidth">760</x:Double>

            <!-- A Windows 11 style card, as used in Settings -->
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
                <Setter Property="Padding" Value="16" />
            </Style>

            <!-- A clickable card (Home page counts) -->
            <Style x:Key="CardButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
                <Setter Property="Padding" Value="16,14" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
            </Style>

            <Style x:Key="SectionHeaderTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Margin" Value="0,24,0,8" />
            </Style>

            <Style x:Key="SecondaryTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <!-- A row in a section's trail of opened records; the disabled variants are for dimmed rows in high contrast. -->
            <Style x:Key="TrailTitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}" />
            <Style x:Key="TrailTitleDisabledTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorDisabledBrush}" />
            </Style>
            <Style x:Key="TrailSubtitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="TrailSubtitleDisabledTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorDisabledBrush}" />
            </Style>
            <Style x:Key="SecondaryGlyphStyle" TargetType="FontIcon">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="DisabledGlyphStyle" TargetType="FontIcon">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorDisabledBrush}" />
            </Style>

            <!--
                Colours for parts built in code. A brush taken from Application.Resources in code
                follows the system theme, not the app's; these setters follow the element's theme.
            -->
            <Style x:Key="SecondaryLineTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="NoWrap" />
            </Style>
            <Style x:Key="TertiaryLineTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
                <Setter Property="TextWrapping" Value="NoWrap" />
            </Style>
            <Style x:Key="SecondaryCaptionTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="TertiaryCaptionTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
            </Style>
            <Style x:Key="AccentCaptionTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            </Style>
            <Style x:Key="SecondaryContentStyle" TargetType="ContentControl">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="IsTabStop" Value="False" />
            </Style>
            <Style x:Key="AccentContentStyle" TargetType="ContentControl">
                <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <Setter Property="IsTabStop" Value="False" />
            </Style>
            <Style x:Key="DashedOutlineStyle" TargetType="Rectangle">
                <Setter Property="Stroke" Value="{ThemeResource ControlStrongStrokeColorDefaultBrush}" />
                <Setter Property="StrokeThickness" Value="1" />
            </Style>
            <Style x:Key="AccentLineStyle" TargetType="Rectangle">
                <Setter Property="Fill" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            </Style>
            <Style x:Key="TextLineStyle" TargetType="Rectangle">
                <Setter Property="Fill" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            </Style>
            <Style x:Key="CardSurfaceStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            </Style>

            <Style x:Key="ValidationTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
                <Setter Property="Margin" Value="0,4,0,0" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
