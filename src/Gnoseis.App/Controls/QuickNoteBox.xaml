<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Gnoseis.App.Controls.QuickNoteBox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Gnoseis.App.Controls"
    xmlns:helpers="using:Gnoseis.App.Helpers">

    <!-- A note linked to one record, written in place: text, optional title, day and time, Save (Ctrl+Enter) -->
    <Border
        Padding="12"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="{StaticResource OverlayCornerRadius}">
        <StackPanel Spacing="8">
            <TextBox
                x:Name="TitleBox"
                AutomationProperties.Name="Note title"
                MaxLength="60"
                PlaceholderText="Title (optional)"
                PreviewKeyDown="Box_PreviewKeyDown"
                TextChanged="Box_TextChanged"
                Visibility="Collapsed" />
            <TextBox
                x:Name="TextBox"
                MinHeight="88"
                MaxHeight="320"
                AcceptsReturn="True"
                PreviewKeyDown="Box_PreviewKeyDown"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                TextChanged="Box_TextChanged"
                TextWrapping="Wrap" />
            <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="8">
                <Button x:Name="DayButton" ToolTipService.ToolTip="Day and time of the note">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE787;" />
                        <TextBlock x:Name="DayText" />
                    </StackPanel>
                    <Button.Flyout>
                        <Flyout x:Name="DayFlyout" Opening="DayFlyout_Opening" Placement="BottomEdgeAlignedLeft">
                            <StackPanel Spacing="12">
                                <CalendarDatePicker
                                    x:Name="DatePicker"
                                    DateChanged="DatePicker_DateChanged"
                                    Header="Day"
                                    IsTodayHighlighted="True" />
                                <TimePicker
                                    x:Name="TimePicker"
                                    ClockIdentifier="24HourClock"
                                    Header="Time"
                                    TimeChanged="TimePicker_TimeChanged" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <Button Click="TitleButton_Click" ToolTipService.ToolTip="Add a title">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE8D2;" />
                        <TextBlock Text="Title" />
                    </StackPanel>
                </Button>
                <HyperlinkButton Click="OpenFullEditor_Click" Content="Open full editor" />
                <Button Click="Cancel_Click" Content="Cancel" />
                <Button
                    x:Name="SaveButton"
                    AutomationProperties.Name="Save note"
                    Click="Save_Click"
                    IsEnabled="False"
                    Style="{StaticResource AccentButtonStyle}"
                    ToolTipService.ToolTip="Save (Ctrl+Enter)">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Save" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Opacity="0.8"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Ctrl+Enter" />
                    </StackPanel>
                </Button>
            </controls:WrapPanel>
            <StackPanel Orientation="Horizontal" Spacing="6">
                <FontIcon
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Glyph="{x:Bind helpers:Glyphs.Link}" />
                <TextBlock
                    x:Name="WillLinkText"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
