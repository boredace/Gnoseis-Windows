<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    x:Class="Gnoseis.App.Resources.RecordTemplates"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Gnoseis.App.Controls"
    xmlns:helpers="using:Gnoseis.App.Helpers"
    xmlns:vm="using:Gnoseis.App.ViewModels">

    <!-- One record in a list: picture (initials or colored type tile), title, preview and trailing text. -->
    <DataTemplate x:Key="RecordRowTemplate" x:DataType="vm:RecordRow">
        <Grid Padding="0,8" ColumnSpacing="12" AutomationProperties.Name="{x:Bind AutomationName}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <PersonPicture
                Width="32"
                Height="32"
                VerticalAlignment="Center"
                DisplayName="{x:Bind Title}"
                Style="{StaticResource ContactPictureStyle}"
                Visibility="{x:Bind IsPerson}" />
            <controls:TypeTile
                Width="32"
                Height="32"
                VerticalAlignment="Center"
                CornerRadius="6"
                FontSize="15"
                Type="{x:Bind Type}"
                Visibility="{x:Bind ShowTile}" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                <TextBlock
                    MaxLines="1"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{x:Bind Title}"
                    TextTrimming="CharacterEllipsis"
                    Visibility="{x:Bind HasTitle}" />
                <TextBlock
                    MaxLines="2"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind Subtitle}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind HasSubtitle}" />
            </StackPanel>
            <TextBlock
                Grid.Column="2"
                Margin="0,2,0,0"
                VerticalAlignment="Top"
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Text="{x:Bind Trailing}"
                Visibility="{x:Bind HasTrailing}" />
        </Grid>
    </DataTemplate>

    <!-- The body line of a linked row: secondary text, or primary for a note without a title -->
    <Style x:Key="RowBodyTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style x:Key="RowBodyPrimaryTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}" />

    <!--
        A linked record's row (record page, and later Home): the type tile (initials for contacts),
        up to three lines of stored data, and the record's link count on the right.
    -->
    <DataTemplate x:Key="LinkedRowTemplate" x:DataType="vm:LinkedRow">
        <Grid Padding="0,8" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <PersonPicture
                Width="32"
                Height="32"
                VerticalAlignment="Top"
                AutomationProperties.AccessibilityView="Raw"
                DisplayName="{x:Bind Title}"
                Style="{StaticResource ContactPictureStyle}"
                Visibility="{x:Bind IsPerson}" />
            <controls:TypeTile
                Width="32"
                Height="32"
                VerticalAlignment="Top"
                AutomationProperties.AccessibilityView="Raw"
                CornerRadius="6"
                FontSize="15"
                Type="{x:Bind Type}"
                Visibility="{x:Bind ShowTile}" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock
                    MaxLines="1"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{x:Bind Title}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap"
                    Visibility="{x:Bind HasTitle}" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    MaxLines="1"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind Path}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap"
                    Visibility="{x:Bind HasPath}" />
                <TextBlock
                    MaxLines="{x:Bind BodyMaxLines}"
                    Style="{x:Bind helpers:Converters.RowBodyStyle(BodyIsPrimary)}"
                    Text="{x:Bind Body}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind HasBody}" />
                <TextBlock
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                    MaxLines="1"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind Accent}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap"
                    Visibility="{x:Bind HasAccent}" />
            </StackPanel>
            <StackPanel
                Grid.Column="2"
                Margin="0,2,0,0"
                VerticalAlignment="Top"
                AutomationProperties.Name="{x:Bind LinkCountAutomationName}"
                Orientation="Horizontal"
                Spacing="4"
                ToolTipService.ToolTip="{x:Bind LinkCountAutomationName}">
                <FontIcon
                    FontSize="11"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Glyph="{x:Bind helpers:Glyphs.Link}" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind LinkCountText}" />
            </StackPanel>
        </Grid>
    </DataTemplate>

    <!-- Sticky group header: a day or first letter in the accent colour, a record type in its outline colour. -->
    <DataTemplate x:Key="RecordGroupHeaderTemplate" x:DataType="vm:RecordGroup">
        <TextBlock
            AutomationProperties.HeadingLevel="Level2"
            Style="{x:Bind helpers:RecordTypeStyles.GroupHeader(Type)}"
            Text="{x:Bind Header}" />
    </DataTemplate>

    <!-- A list row button used where rows sit inside a scrolling page (linked records, Home). -->
    <Style x:Key="RowButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="10,0" />
    </Style>

</ResourceDictionary>
