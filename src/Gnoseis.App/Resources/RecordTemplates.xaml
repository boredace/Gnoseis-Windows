<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    x:Class="Gnoseis.App.Resources.RecordTemplates"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Gnoseis.App.ViewModels">

    <!-- One record in a list: picture (initials or colored type tile), title, preview and trailing text. -->
    <DataTemplate x:Key="RecordRowTemplate" x:DataType="vm:RecordRow">
        <Grid Padding="0,8" ColumnSpacing="12" AutomationProperties.Name="{x:Bind AutomationName}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <PersonPicture
                Width="32"
                Height="32"
                VerticalAlignment="Center"
                DisplayName="{x:Bind Title}"
                Visibility="{x:Bind IsPerson}" />
            <Border
                Width="32"
                Height="32"
                VerticalAlignment="Center"
                Background="{x:Bind TileBrush}"
                CornerRadius="6"
                Visibility="{x:Bind ShowTile}">
                <FontIcon FontSize="15" Foreground="White" Glyph="{x:Bind Glyph}" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                <TextBlock
                    MaxLines="1"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{x:Bind Title}"
                    TextTrimming="CharacterEllipsis"
                    Visibility="{x:Bind HasTitle}" />
                <TextBlock
                    MaxLines="2"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind Subtitle}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind HasSubtitle}" />
            </StackPanel>
            <TextBlock
                Grid.Column="2"
                Margin="0,2,0,0"
                VerticalAlignment="Top"
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Text="{x:Bind Trailing}"
                Visibility="{x:Bind HasTrailing}" />
        </Grid>
    </DataTemplate>

    <!-- Sticky group header (day, first letter or record type). -->
    <DataTemplate x:Key="RecordGroupHeaderTemplate" x:DataType="vm:RecordGroup">
        <TextBlock
            AutomationProperties.HeadingLevel="Level2"
            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
            Style="{StaticResource BodyStrongTextBlockStyle}"
            Text="{x:Bind Header}" />
    </DataTemplate>

    <!-- A list row button used where rows sit inside a scrolling page (linked records, Home). -->
    <Style x:Key="RowButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="10,0" />
    </Style>

</ResourceDictionary>
