<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Gnoseis.App.Views.NotePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Gnoseis.App.Controls"
    KeyDown="Page_KeyDown"
    PreviewKeyDown="Page_PreviewKeyDown"
    SizeChanged="Page_SizeChanged">

    <Grid x:Name="Root">
        <!-- Header and text scroll together -->
        <ScrollViewer
            x:Name="MainScroller"
            HorizontalScrollMode="Disabled"
            ViewChanged="MainScroller_ViewChanged"
            Visibility="Collapsed">
            <Grid x:Name="MainGrid" HorizontalAlignment="Left" RowSpacing="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header: the Note tile, the title, the day and time, the commands -->
                <StackPanel x:Name="HeaderBlock" Spacing="14">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <controls:TypeTile
                            Width="56"
                            Height="56"
                            VerticalAlignment="Top"
                            AutomationProperties.AccessibilityView="Raw"
                            CornerRadius="12"
                            FontSize="26" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock
                                x:Name="TitleText"
                                AutomationProperties.HeadingLevel="Level1"
                                IsTextSelectionEnabled="True"
                                MaxLines="2"
                                Style="{StaticResource SubtitleTextBlockStyle}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="Wrap" />
                            <TextBox
                                x:Name="TitleBox"
                                Margin="0,0,0,2"
                                AutomationProperties.Name="Note title"
                                FontSize="20"
                                FontWeight="SemiBold"
                                MaxLength="60"
                                PlaceholderText="Title (optional)"
                                TextChanged="EditBox_TextChanged"
                                Visibility="Collapsed" />
                            <TextBlock
                                x:Name="DayText"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                IsTextSelectionEnabled="True"
                                Style="{StaticResource BodyTextBlockStyle}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <CommandBar
                            x:Name="Commands"
                            Grid.Column="2"
                            VerticalAlignment="Top"
                            Background="Transparent"
                            DefaultLabelPosition="Right"
                            OverflowButtonVisibility="Collapsed">
                            <AppBarToggleButton x:Name="EditButton" Click="Edit_Click" Label="Edit" ToolTipService.ToolTip="Edit (Ctrl+E)">
                                <AppBarToggleButton.Icon>
                                    <FontIcon Glyph="&#xE70F;" />
                                </AppBarToggleButton.Icon>
                                <AppBarToggleButton.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="E" Invoked="EditAccelerator_Invoked" Modifiers="Control" />
                                </AppBarToggleButton.KeyboardAccelerators>
                            </AppBarToggleButton>
                            <AppBarButton x:Name="LinkButton" Click="Link_Click" Label="Link" ToolTipService.ToolTip="Link existing records (Ctrl+L)">
                                <AppBarButton.Icon>
                                    <FontIcon Glyph="&#xE71B;" />
                                </AppBarButton.Icon>
                                <AppBarButton.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="L" Modifiers="Control" />
                                </AppBarButton.KeyboardAccelerators>
                            </AppBarButton>
                            <AppBarButton
                                x:Name="MoreButton"
                                AutomationProperties.Name="More"
                                LabelPosition="Collapsed"
                                ToolTipService.ToolTip="More">
                                <AppBarButton.Icon>
                                    <FontIcon Glyph="&#xE712;" />
                                </AppBarButton.Icon>
                                <AppBarButton.Flyout>
                                    <MenuFlyout x:Name="MoreMenu" Opening="MoreMenu_Opening" Placement="BottomEdgeAlignedRight" />
                                </AppBarButton.Flyout>
                            </AppBarButton>
                        </CommandBar>
                    </Grid>
                </StackPanel>

                <StackPanel x:Name="BodyPanel" Grid.Row="1" HorizontalAlignment="Left" Spacing="16">
                    <!-- Under 860 px: Note, Linked records -->
                    <SelectorBar x:Name="TabBar" Margin="-8,-8,0,0" SelectionChanged="TabBar_SelectionChanged" Visibility="Collapsed" />

                    <!-- The note: its text in a readable width, then when it was created and changed -->
                    <StackPanel x:Name="NotePanel" Spacing="16">
                        <!-- Body text, line height about 1.6, at most about 75 characters a line -->
                        <RichTextBlock
                            x:Name="NoteText"
                            MaxWidth="720"
                            HorizontalAlignment="Left"
                            AutomationProperties.Name="Note text"
                            IsTextSelectionEnabled="True"
                            LineHeight="22" />

                        <!-- Editing in place: the text, then the day, Cancel and Save -->
                        <StackPanel x:Name="EditPanel" MaxWidth="720" HorizontalAlignment="Stretch" Spacing="8" Visibility="Collapsed">
                            <TextBox
                                x:Name="EditTextBox"
                                MinHeight="160"
                                AcceptsReturn="True"
                                AutomationProperties.Name="Note text"
                                IsSpellCheckEnabled="True"
                                TextChanged="EditBox_TextChanged"
                                TextWrapping="Wrap" />
                            <TextBlock
                                x:Name="InvalidText"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Visibility="Collapsed" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button
                                    x:Name="EditDayButton"
                                    VerticalAlignment="Center"
                                    ToolTipService.ToolTip="Day of the note">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="14" Glyph="&#xE787;" />
                                        <TextBlock x:Name="EditDayText" />
                                    </StackPanel>
                                    <Button.Flyout>
                                        <Flyout x:Name="EditDayFlyout" Opening="EditDayFlyout_Opening" Placement="BottomEdgeAlignedLeft">
                                            <CalendarDatePicker
                                                x:Name="EditDatePicker"
                                                DateChanged="EditDatePicker_DateChanged"
                                                Header="Day"
                                                IsTodayHighlighted="True" />
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <Button Click="EditCancel_Click" Content="Cancel" ToolTipService.ToolTip="Cancel (Esc)" />
                                    <Button
                                        x:Name="EditSaveButton"
                                        AutomationProperties.Name="Save note"
                                        Click="EditSave_Click"
                                        Style="{StaticResource AccentButtonStyle}"
                                        ToolTipService.ToolTip="Save (Ctrl+Enter)">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="Save" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Opacity="0.8"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="Ctrl+Enter" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <StackPanel x:Name="CaptionPanel" MaxWidth="720" HorizontalAlignment="Stretch" Spacing="10">
                            <Rectangle x:Name="CaptionRule" Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                            <TextBlock
                                x:Name="TimesText"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                IsTextSelectionEnabled="True"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Under 860 px: the side column's sections, as a tab -->
                    <StackPanel x:Name="TabLinkedPanel" Spacing="24" Visibility="Collapsed" />
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Side column: what the note is linked to; stays in place while the text scrolls -->
        <ScrollViewer
            x:Name="SideScroller"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            HorizontalScrollMode="Disabled"
            Visibility="Collapsed">
            <Grid x:Name="SidePanel" Padding="0,0,0,24" ColumnSpacing="32" />
        </ScrollViewer>

        <!-- Compact header: once the full header has scrolled out of view -->
        <Grid
            x:Name="CompactHeader"
            VerticalAlignment="Top"
            Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1"
            ColumnSpacing="12"
            Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button
                x:Name="CompactTitleButton"
                Padding="4"
                HorizontalAlignment="Left"
                Background="Transparent"
                BorderThickness="0"
                Click="CompactTitle_Click"
                ToolTipService.ToolTip="Back to the top (Home)">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <controls:TypeTile
                        Width="32"
                        Height="32"
                        AutomationProperties.AccessibilityView="Raw"
                        CornerRadius="7"
                        FontSize="15" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock
                            x:Name="CompactTitleText"
                            FontSize="18"
                            FontWeight="SemiBold"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            x:Name="CompactDayText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </StackPanel>
            </Button>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                <AppBarToggleButton
                    x:Name="CompactEditButton"
                    Width="40"
                    AutomationProperties.Name="Edit"
                    Click="Edit_Click"
                    LabelPosition="Collapsed"
                    ToolTipService.ToolTip="Edit (Ctrl+E)">
                    <AppBarToggleButton.Icon>
                        <FontIcon Glyph="&#xE70F;" />
                    </AppBarToggleButton.Icon>
                </AppBarToggleButton>
                <AppBarButton
                    Width="40"
                    AutomationProperties.Name="Link"
                    Click="Link_Click"
                    LabelPosition="Collapsed"
                    ToolTipService.ToolTip="Link existing records (Ctrl+L)">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE71B;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton
                    x:Name="CompactMoreButton"
                    Width="40"
                    AutomationProperties.Name="More"
                    Click="CompactMore_Click"
                    LabelPosition="Collapsed"
                    ToolTipService.ToolTip="More">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE712;" />
                    </AppBarButton.Icon>
                </AppBarButton>
            </StackPanel>
        </Grid>

        <!-- After Unlink: Undo. Stays until closed, the next unlink, or leaving the page. -->
        <InfoBar
            x:Name="UnlinkInfoBar"
            MaxWidth="560"
            Margin="16"
            VerticalAlignment="Bottom"
            AutomationProperties.LiveSetting="Polite"
            Closed="UnlinkInfoBar_Closed"
            IsClosable="True"
            IsOpen="False"
            Severity="Informational">
            <InfoBar.ActionButton>
                <Button Click="Undo_Click" Content="Undo" />
            </InfoBar.ActionButton>
        </InfoBar>

        <!-- "Copied", next to what was copied -->
        <TeachingTip
            x:Name="CopiedTip"
            IsLightDismissEnabled="True"
            PreferredPlacement="Bottom" />

        <!-- The note was deleted (e.g. while this page was in the back stack) -->
        <StackPanel
            x:Name="MissingState"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12"
            Visibility="Collapsed">
            <FontIcon FontSize="48" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Glyph="&#xE9CE;" />
            <TextBlock HorizontalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" Text="This record no longer exists." />
        </StackPanel>
    </Grid>
</Page>
