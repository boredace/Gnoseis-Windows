<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Gnoseis.App.Views.RecordDetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Gnoseis.App.Controls"
    xmlns:helpers="using:Gnoseis.App.Helpers"
    xmlns:vm="using:Gnoseis.App.ViewModels"
    KeyDown="Page_KeyDown"
    SizeChanged="Page_SizeChanged">

    <Page.Resources>
        <!-- A group heading in the Details section ("Work", "Comments") -->
        <Style x:Key="DetailHeaderTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <!-- A card of linked rows: one day of notes (date left, weekday right), or records of another type -->
        <DataTemplate x:Key="LinkedCardTemplate" x:DataType="vm:LinkedCard">
            <Border Padding="4,6" Style="{StaticResource CardStyle}">
                <StackPanel>
                    <Grid Margin="10,4,10,0" Visibility="{x:Bind HasDayHeader}">
                        <TextBlock
                            AutomationProperties.HeadingLevel="Level3"
                            Style="{StaticResource NoteGroupHeaderTextStyle}"
                            Text="{x:Bind DayHeader}" />
                        <TextBlock
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind Weekday}" />
                    </Grid>
                    <ItemsControl IsTabStop="False" ItemsSource="{x:Bind Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:LinkedRow">
                                <Button
                                    AutomationProperties.Name="{x:Bind AutomationName}"
                                    Click="LinkedRow_Click"
                                    Content="{x:Bind}"
                                    ContentTemplate="{StaticResource LinkedRowTemplate}"
                                    ContextRequested="LinkedRow_ContextRequested"
                                    Style="{StaticResource RowButtonStyle}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- One type in All: header, its latest records, Show all -->
        <DataTemplate x:Key="LinkedAllGroupTemplate" x:DataType="vm:LinkedAllGroup">
            <StackPanel Spacing="8">
                <StackPanel
                    Margin="4,0,0,0"
                    AutomationProperties.HeadingLevel="Level3"
                    AutomationProperties.Name="{x:Bind HeaderAutomationName}"
                    Orientation="Horizontal"
                    Spacing="8">
                    <FontIcon
                        FontSize="14"
                        Glyph="{x:Bind helpers:Glyphs.For(Type)}"
                        Style="{x:Bind helpers:RecordTypeStyles.Glyph(Type)}" />
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Header}" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="{x:Bind CountText}" />
                </StackPanel>
                <ItemsControl IsTabStop="False" ItemsSource="{x:Bind Cards}" ItemTemplate="{StaticResource LinkedCardTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="8" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <HyperlinkButton
                    Margin="0,-4,0,0"
                    Click="ShowAll_Click"
                    Content="{x:Bind ShowAllText}"
                    Tag="{x:Bind Type}"
                    Visibility="{x:Bind HasShowAll}" />
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: type tile, type name, title, subtitle, then the commands -->
        <StackPanel x:Name="Header" Margin="24,20,24,0" Spacing="8">
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <controls:TypeTile
                    Width="48"
                    Height="48"
                    VerticalAlignment="Top"
                    AutomationProperties.AccessibilityView="Raw"
                    CornerRadius="10"
                    FontSize="22"
                    Type="{x:Bind ViewModel.Type}" />

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="0">
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind ViewModel.TypeName}" />
                    <TextBlock
                        AutomationProperties.HeadingLevel="Level1"
                        IsTextSelectionEnabled="True"
                        MaxLines="3"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        IsTextSelectionEnabled="True"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        Visibility="{x:Bind ViewModel.HasSubtitle, Mode=OneWay}" />
                </StackPanel>
            </Grid>

            <CommandBar
                x:Name="Commands"
                Margin="-4,0,0,0"
                HorizontalAlignment="Left"
                Background="Transparent"
                DefaultLabelPosition="Right"
                IsEnabled="{x:Bind ViewModel.IsAvailable, Mode=OneWay}"
                OverflowButtonVisibility="Visible">
                <AppBarButton Click="Edit_Click" Label="Edit" ToolTipService.ToolTip="Edit (Ctrl+E)">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE70F;" />
                    </AppBarButton.Icon>
                    <AppBarButton.KeyboardAccelerators>
                        <KeyboardAccelerator Key="E" Modifiers="Control" />
                    </AppBarButton.KeyboardAccelerators>
                </AppBarButton>
                <AppBarButton Click="LinkExisting_Click" Label="Link" ToolTipService.ToolTip="Link existing records (Ctrl+L)">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE71B;" />
                    </AppBarButton.Icon>
                    <AppBarButton.KeyboardAccelerators>
                        <KeyboardAccelerator Key="L" Modifiers="Control" />
                    </AppBarButton.KeyboardAccelerators>
                </AppBarButton>
                <AppBarButton x:Name="NewLinkedButton" Label="New linked" ToolTipService.ToolTip="Create a record linked to this one">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE710;" />
                    </AppBarButton.Icon>
                    <AppBarButton.Flyout>
                        <MenuFlyout x:Name="NewLinkedMenu" Opening="NewLinkedMenu_Opening" Placement="BottomEdgeAlignedLeft" />
                    </AppBarButton.Flyout>
                </AppBarButton>
                <CommandBar.SecondaryCommands>
                    <AppBarButton Click="Delete_Click" Label="Delete" ToolTipService.ToolTip="Delete (Del)">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE74D;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                </CommandBar.SecondaryCommands>
            </CommandBar>
        </StackPanel>

        <!-- Tabs (a pane narrower than 860 px): Details, All, then one item per linked type -->
        <ScrollViewer
            x:Name="TabBarScroller"
            Grid.Row="1"
            Margin="16,4,16,0"
            HorizontalScrollBarVisibility="Hidden"
            HorizontalScrollMode="Auto"
            VerticalScrollBarVisibility="Disabled"
            VerticalScrollMode="Disabled"
            Visibility="Collapsed">
            <SelectorBar x:Name="TabBar" SelectionChanged="Selector_SelectionChanged" />
        </ScrollViewer>

        <ScrollViewer
            x:Name="BodyScroller"
            Grid.Row="2"
            Visibility="{x:Bind ViewModel.IsAvailable, Mode=OneWay}">
            <Grid x:Name="BodyGrid" Margin="24,16,24,32" ColumnSpacing="32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="DetailsColumn" Width="Auto" />
                    <ColumnDefinition x:Name="LinkedColumn" Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Details: per type -->
                <StackPanel x:Name="DetailsPanel" Spacing="20">

                    <!-- Note text: a readable column with clickable web and e-mail links -->
                    <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.ShowNoteText, Mode=OneWay}">
                        <RichTextBlock
                            x:Name="NoteText"
                            IsTextSelectionEnabled="True"
                            LineHeight="22" />
                    </Border>

                    <!-- Comments of organizations, categories and items -->
                    <StackPanel Visibility="{x:Bind ViewModel.ShowBodyCard, Mode=OneWay}">
                        <TextBlock
                            AutomationProperties.HeadingLevel="Level2"
                            Style="{StaticResource DetailHeaderTextStyle}"
                            Text="{x:Bind ViewModel.BodyHeader}" />
                        <Border Style="{StaticResource CardStyle}">
                            <TextBlock
                                IsTextSelectionEnabled="True"
                                LineHeight="20"
                                Style="{StaticResource BodyTextBlockStyle}"
                                Text="{x:Bind ViewModel.Body, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>

                    <TextBlock
                        Style="{StaticResource SecondaryTextStyle}"
                        Text="{x:Bind ViewModel.NoDetailsText}"
                        Visibility="{x:Bind ViewModel.HasNoDetails, Mode=OneWay}" />
                </StackPanel>

                <!-- Linked records -->
                <StackPanel x:Name="LinkedPanel" Grid.Column="1" Spacing="12">
                    <!-- Side by side: a header with Link, then the selector -->
                    <StackPanel x:Name="LinkedHeader" Spacing="8">
                        <Grid MinHeight="32">
                            <TextBlock
                                VerticalAlignment="Center"
                                AutomationProperties.HeadingLevel="Level2"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="Linked records" />
                            <Button
                                HorizontalAlignment="Right"
                                Click="LinkExisting_Click"
                                ToolTipService.ToolTip="Link existing records (Ctrl+L)"
                                Visibility="{x:Bind ViewModel.HasLinks, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="14" Glyph="{x:Bind helpers:Glyphs.Link}" />
                                    <TextBlock Text="Link" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <ScrollViewer
                            x:Name="LinkedBarScroller"
                            Margin="-8,0,0,0"
                            HorizontalScrollBarVisibility="Hidden"
                            HorizontalScrollMode="Auto"
                            VerticalScrollBarVisibility="Disabled"
                            VerticalScrollMode="Disabled"
                            Visibility="{x:Bind ViewModel.HasLinks, Mode=OneWay}">
                            <SelectorBar x:Name="LinkedBar" SelectionChanged="Selector_SelectionChanged" />
                        </ScrollViewer>
                    </StackPanel>

                    <!-- No links: side by side only (in tabs, Link and New linked are in the command bar) -->
                    <Border x:Name="EmptyState" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                        <StackPanel Spacing="12">
                            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Nothing linked yet." />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Click="LinkExisting_Click" ToolTipService.ToolTip="Link existing records (Ctrl+L)">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="14" Glyph="{x:Bind helpers:Glyphs.Link}" />
                                        <TextBlock Text="Link" />
                                    </StackPanel>
                                </Button>
                                <Button ToolTipService.ToolTip="Create a record linked to this one">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="14" Glyph="&#xE710;" />
                                        <TextBlock Text="New linked" />
                                    </StackPanel>
                                    <Button.Flyout>
                                        <MenuFlyout x:Name="EmptyNewLinkedMenu" Opening="NewLinkedMenu_Opening" Placement="BottomEdgeAlignedLeft" />
                                    </Button.Flyout>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- The selected item's records, laid out in columns by the page -->
                    <Grid x:Name="LinkedContent" ColumnSpacing="16" />
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- After Unlink: Undo. Stays until closed, the next unlink, or leaving the page. -->
        <InfoBar
            x:Name="UnlinkInfoBar"
            Grid.Row="0"
            Grid.RowSpan="3"
            MaxWidth="560"
            Margin="16"
            VerticalAlignment="Bottom"
            AutomationProperties.LiveSetting="Polite"
            Closed="UnlinkInfoBar_Closed"
            IsClosable="True"
            IsOpen="False"
            Severity="Informational">
            <InfoBar.ActionButton>
                <Button Click="Undo_Click" Content="Undo" />
            </InfoBar.ActionButton>
        </InfoBar>

        <!-- The record was deleted (e.g. while this page was in the back stack) -->
        <StackPanel
            Grid.Row="2"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12"
            Visibility="{x:Bind ViewModel.IsMissing, Mode=OneWay}">
            <FontIcon FontSize="48" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Glyph="&#xE9CE;" />
            <TextBlock HorizontalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" Text="This record no longer exists." />
        </StackPanel>
    </Grid>
</Page>
