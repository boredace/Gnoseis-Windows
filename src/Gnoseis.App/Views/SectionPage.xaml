<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Gnoseis.App.Views.SectionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Gnoseis.App.Controls"
    xmlns:helpers="using:Gnoseis.App.Helpers"
    xmlns:vm="using:Gnoseis.App.ViewModels"
    SizeChanged="Page_SizeChanged">

    <Page.Resources>
        <CollectionViewSource x:Name="GroupsSource" IsSourceGrouped="True" />

        <Style x:Key="TrailItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>

        <!--
            A record in the trail: the line from the row above, its picture or type tile, the line to the
            row below, then its title in full (up to two lines) and "In the … list" or its type.
        -->
        <DataTemplate x:Key="TrailRowTemplate" x:DataType="vm:TrailRow">
            <Grid
                Opacity="{x:Bind RowOpacity}"
                ColumnSpacing="12"
                AutomationProperties.Name="{x:Bind AutomationName}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="8" />
                </Grid.RowDefinitions>
                <Canvas SizeChanged="TrailLine_SizeChanged" Visibility="{x:Bind TopLineVisibility}">
                    <Line
                        AutomationProperties.AccessibilityView="Raw"
                        Stroke="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                        StrokeDashArray="{x:Bind helpers:Converters.Dashes(TopLineDashed)}"
                        StrokeThickness="1.5"
                        X1="16"
                        X2="16" />
                </Canvas>
                <PersonPicture
                    Grid.Row="1"
                    Width="32"
                    Height="32"
                    VerticalAlignment="Top"
                    AutomationProperties.AccessibilityView="Raw"
                    DisplayName="{x:Bind Title}"
                    Style="{StaticResource ContactPictureStyle}"
                    Visibility="{x:Bind IsPerson}" />
                <controls:TypeTile
                    Grid.Row="1"
                    Width="32"
                    Height="32"
                    VerticalAlignment="Top"
                    AutomationProperties.AccessibilityView="Raw"
                    CornerRadius="6"
                    FontSize="15"
                    Type="{x:Bind Type}"
                    Visibility="{x:Bind ShowTile}" />
                <Canvas Grid.Row="2" SizeChanged="TrailLine_SizeChanged" Visibility="{x:Bind BottomLineVisibility}">
                    <Line
                        AutomationProperties.AccessibilityView="Raw"
                        Stroke="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                        StrokeDashArray="{x:Bind helpers:Converters.Dashes(BottomLineDashed)}"
                        StrokeThickness="1.5"
                        X1="16"
                        X2="16" />
                </Canvas>
                <StackPanel
                    Grid.Row="1"
                    Grid.RowSpan="2"
                    Grid.Column="1"
                    Margin="0,0,0,8"
                    VerticalAlignment="Top"
                    Spacing="1">
                    <TextBlock
                        x:Phase="0"
                        MaxLines="2"
                        Style="{x:Bind helpers:Converters.TrailTitleStyle(UsesDisabledText)}"
                        Text="{x:Bind Title}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Style="{x:Bind helpers:Converters.TrailSubtitleStyle(UsesDisabledText)}"
                        Text="{x:Bind Subtitle}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <!-- List on the left, the selected record (or an editor) on the right. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ListColumn" Width="360" />
            <ColumnDefinition x:Name="DividerColumn" Width="Auto" />
            <ColumnDefinition x:Name="DetailColumn" Width="*" />
        </Grid.ColumnDefinitions>

        <!-- List pane -->
        <Grid x:Name="ListPane">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Margin="20,20,16,0" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock
                        AutomationProperties.HeadingLevel="Level1"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="{x:Bind ViewModel.Title}" />
                    <TextBlock
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.CountText, Mode=OneWay}" />
                </StackPanel>
                <Button
                    x:Name="NewButton"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="{x:Bind ViewModel.NewButtonText}"
                    Click="NewButton_Click"
                    Style="{x:Bind helpers:RecordTypeStyles.Button(ViewModel.Type)}">
                    <ToolTipService.ToolTip>
                        <ToolTip Content="{x:Bind helpers:Converters.Shortcut(ViewModel.NewButtonText, 'Ctrl+N')}" />
                    </ToolTipService.ToolTip>
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="N" Modifiers="Control" />
                    </Button.KeyboardAccelerators>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE710;" />
                        <TextBlock Text="New" />
                    </StackPanel>
                </Button>
            </Grid>

            <AutoSuggestBox
                x:Name="FilterBox"
                Grid.Row="1"
                Margin="20,12,16,8"
                AutomationProperties.Name="{x:Bind ViewModel.FilterPlaceholder}"
                PlaceholderText="{x:Bind ViewModel.FilterPlaceholder}"
                QueryIcon="Filter"
                QuerySubmitted="FilterBox_QuerySubmitted"
                Text="{x:Bind ViewModel.Filter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <ListView
                x:Name="RecordList"
                Grid.Row="2"
                Padding="8,0,8,16"
                AutomationProperties.Name="{x:Bind ViewModel.Title}"
                ItemTemplate="{StaticResource RecordRowTemplate}"
                IsItemClickEnabled="True"
                IsSynchronizedWithCurrentItem="False"
                ItemClick="RecordList_ItemClick"
                KeyDown="RecordList_KeyDown"
                SelectionChanged="RecordList_SelectionChanged"
                SelectionMode="Single">
                <ListView.GroupStyle>
                    <GroupStyle HeaderTemplate="{StaticResource RecordGroupHeaderTemplate}" />
                </ListView.GroupStyle>
            </ListView>

            <ProgressRing
                Grid.Row="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsActive="{x:Bind helpers:Converters.Not(ViewModel.IsLoaded), Mode=OneWay}" />

            <!-- Nothing yet (Android NoRecordsToDisplay) -->
            <StackPanel
                Grid.Row="2"
                Margin="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8"
                Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
                <FontIcon FontSize="40" Glyph="{x:Bind ViewModel.Glyph}" Style="{x:Bind helpers:RecordTypeStyles.Glyph(ViewModel.Type)}" />
                <TextBlock HorizontalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.EmptyText}" />
                <TextBlock HorizontalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind ViewModel.EmptyHint}" TextAlignment="Center" />
            </StackPanel>

            <TextBlock
                Grid.Row="2"
                Margin="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Style="{StaticResource SecondaryTextStyle}"
                Text="No matches"
                Visibility="{x:Bind ViewModel.IsFilteredEmpty, Mode=OneWay}" />
        </Grid>

        <!-- Trail column: in place of the list while records opened from one another are shown -->
        <Grid x:Name="TrailPane" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Margin="20,20,16,12" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock
                        AutomationProperties.HeadingLevel="Level1"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="Opened records" />
                    <TextBlock
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind TrailView.Subtitle, Mode=OneWay}" />
                </StackPanel>
                <Button
                    x:Name="BackToListButton"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Back to list"
                    Click="BackToListButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE8FD;" />
                        <TextBlock Text="Back to list" />
                    </StackPanel>
                </Button>
            </Grid>

            <ListView
                x:Name="TrailList"
                Grid.Row="1"
                Padding="8,0,8,16"
                AutomationProperties.Name="Opened records"
                IsItemClickEnabled="True"
                ItemClick="TrailList_ItemClick"
                ItemContainerStyle="{StaticResource TrailItemStyle}"
                ItemTemplate="{StaticResource TrailRowTemplate}"
                SelectionChanged="TrailList_SelectionChanged"
                SelectionMode="Single"
                SingleSelectionFollowsFocus="False" />

            <Border
                Grid.Row="2"
                Padding="20,12,16,16"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
                <TextBlock
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="{x:Bind TrailView.Hint, Mode=OneWay}"
                    TextWrapping="Wrap" />
            </Border>
        </Grid>

        <Border
            x:Name="Divider"
            Grid.Column="1"
            Width="1"
            Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

        <!-- Detail pane: the selected record, an editor, or a placeholder -->
        <Frame x:Name="DetailFrame" Grid.Column="2" />
    </Grid>
</Page>
