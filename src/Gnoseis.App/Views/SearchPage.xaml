<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Gnoseis.App.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Page.Resources>
        <CollectionViewSource x:Name="GroupsSource" IsSourceGrouped="True" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            Margin="{StaticResource PageMargin}"
            AutomationProperties.HeadingLevel="Level1"
            Style="{StaticResource TitleTextBlockStyle}"
            Text="Search" />

        <StackPanel Grid.Row="1" Margin="36,16,36,0" Spacing="8">
            <TextBox
                x:Name="QueryBox"
                MaxWidth="{StaticResource FormMaxWidth}"
                MinWidth="320"
                HorizontalAlignment="Left"
                AutomationProperties.Name="Search all records"
                PlaceholderText="Search all records"
                Text="{x:Bind ViewModel.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind ViewModel.Hint, Mode=OneWay}" />
        </StackPanel>

        <ListView
            x:Name="ResultList"
            Grid.Row="2"
            Margin="20,8,20,0"
            Padding="0,0,0,24"
            AutomationProperties.Name="Search results"
            IsItemClickEnabled="True"
            ItemClick="ResultList_ItemClick"
            ItemTemplate="{StaticResource RecordRowTemplate}"
            IsSynchronizedWithCurrentItem="False"
            SelectionMode="None">
            <ListView.GroupStyle>
                <GroupStyle HeaderTemplate="{StaticResource RecordGroupHeaderTemplate}" />
            </ListView.GroupStyle>
        </ListView>
    </Grid>
</Page>
