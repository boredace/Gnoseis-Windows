<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Gnoseis.App.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Gnoseis.App.Controls"
    NavigationCacheMode="Required">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            Margin="{StaticResource PageMargin}"
            AutomationProperties.HeadingLevel="Level1"
            Style="{StaticResource TitleTextBlockStyle}"
            Text="Search" />

        <controls:RecordSearchView
            x:Name="Search"
            Grid.Row="1"
            MaxWidth="880"
            Margin="36,16,36,0"
            HorizontalAlignment="Stretch"
            CreateRequested="Search_CreateRequested"
            PlaceholderText="Search all records"
            RecordInvoked="Search_RecordInvoked"
            ResultsName="Search results" />
    </Grid>
</Page>
