<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Gnoseis.App.Views.NoteFields"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Gnoseis.App.Controls"
    xmlns:helpers="using:Gnoseis.App.Helpers">

    <!-- The note's fields inside the shared edit page -->
    <StackPanel Margin="0,16,0,0" Spacing="16">
        <controls:FormTextBox x:Name="TitleBox" Field="{x:Bind ViewModel.NoteTitle}" PlaceholderText="Optional" />
        <controls:FormTextBox x:Name="TextBox" Field="{x:Bind ViewModel.Text}" Kind="Multiline" />
        <CalendarDatePicker
            Date="{x:Bind ViewModel.Date, Mode=TwoWay}"
            Header="Day"
            IsTodayHighlighted="True" />
        <TextBlock
            Style="{StaticResource SecondaryTextStyle}"
            Text="A note needs a title or some text."
            Visibility="{x:Bind helpers:Converters.VisibleWhenFalse(ViewModel.IsValid), Mode=OneWay}" />
    </StackPanel>
</UserControl>
