<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Gnoseis.App.Views.ContactFields"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Gnoseis.App.Controls">

    <UserControl.Resources>
        <Style x:Key="PairGridStyle" TargetType="Grid">
            <Setter Property="ColumnSpacing" Value="16" />
            <Setter Property="RowSpacing" Value="12" />
        </Style>
    </UserControl.Resources>

    <!-- The contact's fields inside the shared edit page -->
    <StackPanel x:Name="Root" Margin="0,4,0,0" SizeChanged="Root_SizeChanged">

        <TextBlock AutomationProperties.HeadingLevel="Level2" Style="{StaticResource SectionHeaderTextStyle}" Text="Name" />
        <Grid Style="{StaticResource PairGridStyle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <controls:FormTextBox x:Name="FirstNameBox" Field="{x:Bind ViewModel.NameFirst}" Kind="Name" />
            <controls:FormTextBox Grid.Column="1" Field="{x:Bind ViewModel.NameLast}" IsRequired="True" Kind="Name" />
        </Grid>

        <TextBlock AutomationProperties.HeadingLevel="Level2" Style="{StaticResource SectionHeaderTextStyle}" Text="Work" />
        <Grid Style="{StaticResource PairGridStyle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <controls:FormTextBox Field="{x:Bind ViewModel.JobTitle}" />
            <controls:FormTextBox Grid.Column="1" Field="{x:Bind ViewModel.Company}" />
        </Grid>

        <TextBlock AutomationProperties.HeadingLevel="Level2" Style="{StaticResource SectionHeaderTextStyle}" Text="Phone" />
        <Grid Style="{StaticResource PairGridStyle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <controls:FormTextBox Field="{x:Bind ViewModel.PhoneMain}" Kind="Phone" />
            <controls:FormTextBox Grid.Column="1" Field="{x:Bind ViewModel.PhoneMobile}" Kind="Phone" />
            <controls:FormTextBox Grid.Row="1" Field="{x:Bind ViewModel.PhoneHome}" Kind="Phone" />
            <controls:FormTextBox Grid.Row="1" Grid.Column="1" Field="{x:Bind ViewModel.PhoneWork}" Kind="Phone" />
        </Grid>

        <TextBlock AutomationProperties.HeadingLevel="Level2" Style="{StaticResource SectionHeaderTextStyle}" Text="Email" />
        <Grid Style="{StaticResource PairGridStyle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <controls:FormTextBox Field="{x:Bind ViewModel.EmailMain}" Kind="Email" />
            <controls:FormTextBox Grid.Column="1" Field="{x:Bind ViewModel.EmailMobile}" Kind="Email" />
            <controls:FormTextBox Grid.Row="1" Field="{x:Bind ViewModel.EmailHome}" Kind="Email" />
            <controls:FormTextBox Grid.Row="1" Grid.Column="1" Field="{x:Bind ViewModel.EmailWork}" Kind="Email" />
        </Grid>

        <controls:FormTextBox Margin="0,24,0,8" Field="{x:Bind ViewModel.Comments}" Kind="Multiline" />
    </StackPanel>
</UserControl>
