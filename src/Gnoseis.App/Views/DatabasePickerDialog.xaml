<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Gnoseis.App.Views.DatabasePickerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Gnoseis.App.Views"
    CloseButtonText="Quit"
    DefaultButton="Primary"
    PrimaryButtonClick="DatabasePickerDialog_PrimaryButtonClick"
    PrimaryButtonText="Open"
    SecondaryButtonClick="DatabasePickerDialog_SecondaryButtonClick"
    SecondaryButtonText="Add folder…"
    Title="Choose a database">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">640</x:Double>
    </ContentDialog.Resources>

    <local:DatabaseChooser x:Name="Chooser" MinWidth="440" />
</ContentDialog>
