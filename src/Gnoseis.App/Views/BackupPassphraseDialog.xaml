<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Gnoseis.App.Views.BackupPassphraseDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="False"
    PrimaryButtonClick="Primary_Click"
    PrimaryButtonText="Open"
    Title="Enter the backup passphrase">

    <StackPanel MinWidth="420" Spacing="8">
        <TextBlock x:Name="MessageText" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" />
        <PasswordBox
            x:Name="PassphraseBox"
            Header="Passphrase"
            PasswordChanged="Passphrase_PasswordChanged"
            PasswordRevealMode="Peek" />
        <TextBlock
            x:Name="ProblemText"
            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
            Style="{StaticResource CaptionTextBlockStyle}"
            Text="Wrong passphrase, or the file is damaged"
            TextWrapping="Wrap"
            Visibility="Collapsed" />
        <StackPanel x:Name="WorkingPanel" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
            <ProgressRing Width="16" Height="16" IsActive="True" />
            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Checking the passphrase…" />
        </StackPanel>
    </StackPanel>
</ContentDialog>
