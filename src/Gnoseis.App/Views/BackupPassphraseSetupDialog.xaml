<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Gnoseis.App.Views.BackupPassphraseSetupDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="Primary_Click"
    PrimaryButtonText="Next"
    SecondaryButtonClick="Secondary_Click"
    Title="Set up the backup passphrase">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">640</x:Double>
    </ContentDialog.Resources>

    <Grid MinWidth="460">
        <!-- Step 1: choose a passphrase -->
        <StackPanel x:Name="ChoosePanel" Spacing="12">
            <TextBlock
                Style="{StaticResource BodyTextBlockStyle}"
                Text="Backups will be encrypted with AES-256 and can only be opened with this passphrase, here or in Gnoseis for Android."
                TextWrapping="Wrap" />
            <TextBlock
                x:Name="ChangeNote"
                Style="{StaticResource BodyTextBlockStyle}"
                Text="Backups made before keep the passphrase they were made with."
                TextWrapping="Wrap"
                Visibility="Collapsed" />

            <RadioButtons x:Name="KindButtons" SelectedIndex="0" SelectionChanged="Kind_SelectionChanged">
                <RadioButton Content="Generate a passphrase (recommended)" />
                <RadioButton Content="Use my own passphrase" />
            </RadioButtons>

            <StackPanel x:Name="GeneratedPanel" Spacing="8">
                <Border
                    Padding="16,12"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource ControlCornerRadius}">
                    <Grid x:Name="WordsGrid" ColumnSpacing="20" RowSpacing="6" />
                </Border>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Click="Copy_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE8C8;" />
                            <TextBlock Text="Copy" />
                        </StackPanel>
                    </Button>
                    <Button Click="NewWords_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE72C;" />
                            <TextBlock Text="New words" />
                        </StackPanel>
                    </Button>
                    <TextBlock
                        x:Name="CopiedText"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}" />
                </StackPanel>
            </StackPanel>

            <StackPanel x:Name="OwnPanel" Spacing="6" Visibility="Collapsed">
                <PasswordBox
                    x:Name="OwnBox"
                    Header="Passphrase"
                    PasswordChanged="Own_PasswordChanged"
                    PasswordRevealMode="Peek" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="At least 12 characters. The backup is exactly as strong as this passphrase."
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Name="EstimateText"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="The strength estimate isn't available."
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Name="OwnProblemText"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />
                <InfoBar
                    x:Name="UseAnywayInfoBar"
                    IsClosable="False"
                    Message="The strength estimate isn't available, so Gnoseis can't tell how strong this passphrase is. A backup is only as strong as its passphrase."
                    Severity="Warning"
                    Title="Use this passphrase anyway?" />
            </StackPanel>

            <InfoBar
                IsClosable="False"
                IsOpen="True"
                Message="Keep this passphrase somewhere safe, away from your backups. If it's lost, encrypted backups can't be opened, and Gnoseis can't reset it."
                Severity="Warning"
                Title="A lost passphrase can't be recovered" />
        </StackPanel>

        <!-- Step 2: enter it again -->
        <StackPanel x:Name="ConfirmPanel" Spacing="8" Visibility="Collapsed">
            <TextBlock
                Style="{StaticResource BodyTextBlockStyle}"
                Text="Enter the passphrase again, typed or pasted from where you keep it."
                TextWrapping="Wrap" />
            <PasswordBox
                x:Name="ConfirmBox"
                Header="Passphrase"
                PasswordChanged="Confirm_PasswordChanged"
                PasswordRevealMode="Peek" />
            <TextBlock
                x:Name="ConfirmProblemText"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                TextWrapping="Wrap"
                Visibility="Collapsed" />
            <StackPanel x:Name="WorkingPanel" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                <ProgressRing Width="16" Height="16" IsActive="True" />
                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Preparing the key…" />
            </StackPanel>
        </StackPanel>
    </Grid>
</ContentDialog>
