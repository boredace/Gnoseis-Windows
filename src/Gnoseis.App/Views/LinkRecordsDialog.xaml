<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Gnoseis.App.Views.LinkRecordsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Gnoseis.App.Controls"
    xmlns:helpers="using:Gnoseis.App.Helpers"
    xmlns:vm="using:Gnoseis.App.ViewModels"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="{x:Bind Model.CanLink, Mode=OneWay}"
    PrimaryButtonClick="LinkRecordsDialog_PrimaryButtonClick"
    PrimaryButtonText="{x:Bind Model.LinkButtonText, Mode=OneWay}"
    Title="{x:Bind Model.PickerTitle, Mode=OneWay}">

    <ContentDialog.Resources>
        <!-- About 720 wide for the content, the height following the window up to the cap. -->
        <x:Double x:Key="ContentDialogMaxWidth">780</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">860</x:Double>

        <!-- A ticked record in the selected records flyout: on its type's fill, with its check box. -->
        <DataTemplate x:Key="SelectedRowTemplate" x:DataType="vm:SearchRow">
            <Grid AutomationProperties.Name="{x:Bind AutomationName}">
                <Border Style="{x:Bind helpers:RecordTypeStyles.Fill(Type)}" />
                <Grid Padding="10,6" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <PersonPicture
                        Width="32"
                        Height="32"
                        AutomationProperties.AccessibilityView="Raw"
                        DisplayName="{x:Bind Title}"
                        Style="{StaticResource ContactPictureStyle}"
                        Visibility="{x:Bind IsPerson}" />
                    <controls:TypeTile
                        Width="32"
                        Height="32"
                        CornerRadius="6"
                        FontSize="15"
                        Type="{x:Bind Type}"
                        Visibility="{x:Bind ShowTile}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <TextBlock
                            MaxLines="1"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="{x:Bind Title}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            MaxLines="1"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind Context}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />
                    </StackPanel>
                    <CheckBox
                        Grid.Column="2"
                        MinWidth="0"
                        Margin="0,0,-8,0"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="{x:Bind Title}"
                        Click="SelectedCheck_Click"
                        IsChecked="{x:Bind IsChecked, Mode=OneWay}"
                        Tag="{x:Bind}" />
                </Grid>
            </Grid>
        </DataTemplate>
    </ContentDialog.Resources>

    <Grid x:Name="Root" Width="720" Height="560">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:RecordSearchView
            x:Name="Search"
            CreateRequested="Search_CreateRequested"
            PlaceholderText="Search records to link"
            ResultsName="Records to link" />

        <!-- While anything is ticked: the first five, how many, and every ticked record in a flyout. -->
        <Grid
            Grid.Row="1"
            Margin="0,8,0,0"
            Padding="0,12,0,0"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            ColumnSpacing="16"
            Visibility="{x:Bind Model.HasSelection, Mode=OneWay, FallbackValue=Collapsed}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel
                x:Name="SelectedTiles"
                VerticalAlignment="Center"
                AutomationProperties.AccessibilityView="Raw"
                Orientation="Horizontal" />
            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="{x:Bind Model.SelectedText, Mode=OneWay, FallbackValue=''}" />
            <HyperlinkButton
                x:Name="ShowSelectedButton"
                Grid.Column="2"
                VerticalAlignment="Center"
                AutomationProperties.Name="Show selected records"
                Click="ShowSelectedButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="Show selected" />
                    <FontIcon FontSize="10" Glyph="&#xE70E;" />
                </StackPanel>
                <FlyoutBase.AttachedFlyout>
                    <Flyout x:Name="SelectedFlyout" Opening="SelectedFlyout_Opening" Placement="TopEdgeAlignedLeft">
                        <StackPanel Width="340" Spacing="6">
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Selected, in the order picked" />
                            <ListView
                                x:Name="SelectedList"
                                MaxHeight="360"
                                AutomationProperties.Name="Selected records"
                                ItemTemplate="{StaticResource SelectedRowTemplate}"
                                SelectionMode="None">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0,1" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                            </ListView>
                        </StackPanel>
                    </Flyout>
                </FlyoutBase.AttachedFlyout>
            </HyperlinkButton>
        </Grid>
    </Grid>
</ContentDialog>
