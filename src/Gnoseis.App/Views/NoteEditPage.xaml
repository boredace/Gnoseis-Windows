<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Gnoseis.App.Views.NoteEditPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Gnoseis.App.Controls"
    xmlns:helpers="using:Gnoseis.App.Helpers">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="{StaticResource PageMargin}" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                AutomationProperties.HeadingLevel="Level1"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="{x:Bind ViewModel.PageTitle}" />
            <Button
                Grid.Column="1"
                MinWidth="96"
                Click="Save_Click"
                Content="Save"
                IsEnabled="{x:Bind ViewModel.CanSave, Mode=OneWay}"
                Style="{StaticResource AccentButtonStyle}"
                ToolTipService.ToolTip="Save (Ctrl+S)">
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Key="S" Modifiers="Control" />
                </Button.KeyboardAccelerators>
            </Button>
            <Button
                Grid.Column="2"
                MinWidth="96"
                Click="Cancel_Click"
                Content="Cancel"
                ToolTipService.ToolTip="Cancel (Esc)">
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Escape" />
                </Button.KeyboardAccelerators>
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="1" Padding="{StaticResource PageContentMargin}">
            <!-- Left-aligned form that grows up to FormMaxWidth -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="{StaticResource FormMaxWidth}" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
            <StackPanel Margin="0,16,0,0" HorizontalAlignment="Stretch" Spacing="16">
                <controls:FormTextBox x:Name="TitleBox" Field="{x:Bind ViewModel.NoteTitle}" PlaceholderText="Optional" />
                <CalendarDatePicker
                    Date="{x:Bind ViewModel.Date, Mode=TwoWay}"
                    Header="Date"
                    IsTodayHighlighted="True" />
                <controls:FormTextBox Field="{x:Bind ViewModel.Text}" Kind="Multiline" />
                <TextBlock
                    Style="{StaticResource SecondaryTextStyle}"
                    Text="A note needs a title or some text."
                    Visibility="{x:Bind helpers:Converters.VisibleWhenFalse(ViewModel.IsValid), Mode=OneWay}" />
            </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
