<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Gnoseis.Core</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>14</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Argon2id for encrypted backups; only Argon2 is used from it. Pure managed code, MIT licence. -->
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <!-- EFF large word list (CC BY 4.0) for generated backup passphrases, unchanged from eff.org. -->
    <EmbeddedResource Include="Backup\eff_large_wordlist.txt" LogicalName="Gnoseis.Core.Backup.eff_large_wordlist.txt" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Gnoseis.Core.Tests" />
  </ItemGroup>

</Project>
